# Environment Variables Example Configuration
# Copy this file to .env.local or .env for local environment setup.

# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Google Analytics Tracking ID (Public client-side)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-ZHCWYE58DS

# SendGrid Mail API Key (Server-side)
SENDGRID_API_KEY=

# Firebase Admin SDK Base64 Config (Server-side)
FIREBASE_ADMIN_SDK_CONFIG_B64=

# Firebase Public Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecosystem-hub
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecosystem-hub.firebaseapp.com
